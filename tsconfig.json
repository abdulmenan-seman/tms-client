{

"compilerOptions": {
"target": "es2025",
"module": "nodenext",
"strict": true,
"rootDir": ".",
"outDir": "./dist",
"noImplicitAny": true,
"strictNullChecks": true,
"noUncheckedIndexedAccess": true
},
"include": ["**/*.ts"],
"exclude": ["node_modules", "dist"]
}